# ==============================================================================
# Smart Cafeteria Waste Reduction System — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase, PostgreSQL, RDS, Neon, or SQLite)
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection URL:
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
#
# Examples:
#
# Supabase Transaction Pooler / Direct:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Local / Self-Hosted PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafeteria
#
# Neon / AWS RDS:
# DATABASE_URL=postgresql://username:password@ep-cool-project.us-east-2.aws.neon.tech/neondb
#
# SQLite WAL Mode (Default if DATABASE_URL is commented out):
# DATABASE_URL=sqlite:///database/cafeteria.db

# ------------------------------------------------------------------------------
# 2. RUNTIME & DEVICE
# ------------------------------------------------------------------------------
DEVICE=auto
LOG_LEVEL=INFO
DEBUG_OVERLAY=false
