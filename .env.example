# Copy this file to .env and fill in values
# Most settings live in configs/config.yaml
# .env is for secrets and machine-specific overrides only

# Override config file location (optional)
# CAFETERIA_CONFIG=configs/config.yaml

# Force CPU even if CUDA is available (set to "cpu" to disable GPU)
# CAFETERIA_DEVICE=cpu

# Streamlit server port (default: 8501)
# STREAMLIT_SERVER_PORT=8501

# Engine status polling interval in seconds (used by dashboard)
# CAFETERIA_POLL_INTERVAL=0.5
